{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "location": "eur3"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "muzician-b0953",
          "appId": "1:249096781239:android:26f08e534c54a3f3713c32",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "muzician-b0953",
          "configurations": {
            "android": "1:249096781239:android:26f08e534c54a3f3713c32",
            "ios": "1:249096781239:ios:33d477f62b600d1e713c32",
            "macos": "1:249096781239:ios:8c322530b93d2028713c32",
            "web": "1:249096781239:web:1f89b52dfde0a6ab713c32",
            "windows": "1:249096781239:web:f9d9713fa2f22309713c32"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "muzician-b0953",
          "appId": "1:249096781239:ios:33d477f62b600d1e713c32",
          "uploadDebugSymbols": false,
